{
  "name": "tenfold",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test",
    "dev": "npm run dev -w @tenfold/web",
    "build": "npm run build -w @tenfold/web",
    "functions:sync": "node scripts/sync-functions.mjs",
    "functions:check": "node scripts/sync-functions.mjs && cd supabase/functions/game && npx --yes deno check --config deno.json index.ts && cd ../play && npx --yes deno check --config deno.json index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}
